# Free Neon Postgres connection string (https://neon.tech)
# Local and Vercel both use Postgres — SQLite is not used on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Free API key from https://aistudio.google.com/apikey
# Optional for browsing demo data; required for live resume analysis
GOOGLE_GENERATIVE_AI_API_KEY=""
